{
  "meeting_id": "[meeting-id]",
  "generated_at": "[ISO-8601]",
  "contract_version": "1.1.0",
  "files": [
    {
      "path": "knowledge/people/[person-id].md",
      "action": "create",
      "content": "[полное содержимое файла по templates/person.template.md]"
    },
    {
      "path": "knowledge/topics/[topic-id].md",
      "action": "update",
      "content": "[полное новое содержимое; все строки с пометкой (m) из текущего файла обязаны сохраниться]"
    }
  ],
  "records": [
    {
      "registry": "knowledge/commitments/open.jsonl",
      "action": "append",
      "id": "[commitment-id]",
      "record": {"id": "[commitment-id]", "meeting_id": "[meeting-id]", "type": "deliver_document", "who": "[person-id]", "to_whom": null, "what": "[что]", "deadline": null, "deadline_verbatim": null, "status": "open", "value_rub": null, "source_quote": "[буквальная цитата]", "source_timestamp": "00:00:00", "confidence": "certain", "linked_topic": "[topic-id]", "follow_up": {"reminder_date": null, "reminder_sent": false, "actual_completion_date": null, "completion_notes": null}}
    },
    {
      "registry": "knowledge/risks/active.jsonl",
      "action": "update",
      "id": "[risk-id]",
      "record": {"last_seen_meeting_id": "[meeting-id]"}
    },
    {
      "registry": "knowledge/commitments/open.jsonl",
      "action": "close",
      "id": "[commitment-id]",
      "record": {"status": "done", "follow_up": {"reminder_date": null, "reminder_sent": false, "actual_completion_date": "[YYYY-MM-DD]", "completion_notes": "[доказательство результата]"}}
    }
  ],
  "accounting": [
    {"ref": "participant:[person-id]", "fate": "record", "target": {"file": "knowledge/people/[person-id].md"}, "certainty": "sure"},
    {"ref": "organization:[organization-id]", "fate": "skip", "reason": "[почему не переносим: например, наша организация, карточка не ведётся]", "certainty": "sure"},
    {"ref": "commitment:[commitment-id]", "fate": "record", "target": {"registry": "knowledge/commitments/open.jsonl", "id": "[commitment-id]"}, "certainty": "sure"},
    {"ref": "question:1", "fate": "record", "target": {"file": "knowledge/topics/[topic-id].md", "fragment": "[одна или несколько целых строк из content этой карточки]"}, "certainty": "sure"},
    {"ref": "risk:[risk-id-из-08]", "fate": "merge", "target": {"registry": "knowledge/risks/active.jsonl", "id": "[risk-id]"}, "reason": "[с чем объединяем и почему это тот же риск]", "certainty": "doubtful", "question": "[вопрос пользователю: это тот же риск или новый?]"},
    {"ref": "decision:1", "fate": "skip", "reason": "[почему не переносим]", "certainty": "doubtful", "question": "[вопрос пользователю]"}
  ]
}
